{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the ShieldForge webview. Only the application's own commands are exposed - no filesystem, shell, dialog, http or process plugin permissions are granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "allow-get-app-info",
    "allow-get-protection-status",
    "allow-get-scanner-descriptor",
    "allow-scan-start",
    "allow-scan-progress",
    "allow-scan-cancel",
    "allow-scan-results",
    "allow-quarantine-list",
    "allow-quarantine-restore",
    "allow-quarantine-delete",
    "allow-update-status",
    "allow-update-check",
    "allow-history-list",
    "allow-audit-list"
  ]
}
